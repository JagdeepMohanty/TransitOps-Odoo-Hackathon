generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum RoleName {
  FLEET_MANAGER
  DISPATCHER
  SAFETY_OFFICER
  FINANCIAL_ANALYST
}

enum VehicleStatus {
  AVAILABLE
  ON_TRIP
  IN_SHOP
  RETIRED
}

enum DriverStatus {
  AVAILABLE
  ON_TRIP
  OFF_DUTY
  SUSPENDED
}

enum TripStatus {
  DRAFT
  DISPATCHED
  COMPLETED
  CANCELLED
}

enum MaintenanceStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ExpenseType {
  FUEL
  TOLL
  MAINTENANCE
  PARKING
  REPAIR
  OTHER
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Role {
  id        Int      @id @default(autoincrement())
  name      RoleName @unique
  users     User[]
  createdAt DateTime @default(now())

  @@map("roles")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  roleId       Int
  role         Role     @relation(fields: [roleId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Vehicle {
  id                 Int           @id @default(autoincrement())
  registrationNumber String        @unique
  name               String
  model              String?
  type               String
  region             String?
  maxLoadCapacity    Decimal       @db.Decimal(10, 2)
  odometer           Decimal       @default(0) @db.Decimal(12, 2)
  acquisitionCost    Decimal       @db.Decimal(12, 2)
  status             VehicleStatus @default(AVAILABLE)
  trips              Trip[]
  maintenanceLogs    Maintenance[]
  fuelLogs           FuelLog[]
  expenses           Expense[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([status])
  @@index([type])
  @@index([region])
  @@map("vehicles")
}

model Driver {
  id                Int          @id @default(autoincrement())
  name              String
  licenseNumber     String       @unique
  licenseCategory   String
  licenseExpiryDate DateTime
  contactNumber     String
  safetyScore       Int          @default(100)
  status            DriverStatus @default(AVAILABLE)
  trips             Trip[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([status])
  @@index([licenseExpiryDate])
  @@map("drivers")
}

model Trip {
  id              Int        @id @default(autoincrement())
  source          String
  destination     String
  cargoWeight     Decimal    @db.Decimal(10, 2)
  plannedDistance Decimal    @db.Decimal(10, 2)
  actualDistance  Decimal?   @db.Decimal(10, 2)
  startOdometer   Decimal?   @db.Decimal(12, 2)
  finalOdometer   Decimal?   @db.Decimal(12, 2)
  fuelConsumed    Decimal?   @db.Decimal(10, 2)
  revenue         Decimal?   @db.Decimal(12, 2)
  status          TripStatus @default(DRAFT)
  vehicleId       Int
  vehicle         Vehicle    @relation(fields: [vehicleId], references: [id])
  driverId        Int
  driver          Driver     @relation(fields: [driverId], references: [id])
  fuelLogs        FuelLog[]
  expenses        Expense[]
  dispatchedAt    DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status])
  @@index([vehicleId])
  @@index([driverId])
  @@map("trips")
}

model Maintenance {
  id              Int               @id @default(autoincrement())
  maintenanceType String
  description     String?
  startDate       DateTime
  endDate         DateTime?
  cost            Decimal           @default(0) @db.Decimal(12, 2)
  status          MaintenanceStatus @default(ACTIVE)
  notes           String?
  vehicleId       Int
  vehicle         Vehicle           @relation(fields: [vehicleId], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status])
  @@index([vehicleId])
  @@map("maintenance_logs")
}

model FuelLog {
  id        Int      @id @default(autoincrement())
  liters    Decimal  @db.Decimal(10, 2)
  cost      Decimal  @db.Decimal(12, 2)
  logDate   DateTime
  odometer  Decimal? @db.Decimal(12, 2)
  vehicleId Int
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  tripId    Int?
  trip      Trip?    @relation(fields: [tripId], references: [id])
  createdAt DateTime @default(now())

  @@index([vehicleId])
  @@index([tripId])
  @@map("fuel_logs")
}

model Expense {
  id          Int         @id @default(autoincrement())
  type        ExpenseType
  amount      Decimal     @db.Decimal(12, 2)
  description String?
  expenseDate DateTime
  vehicleId   Int
  vehicle     Vehicle     @relation(fields: [vehicleId], references: [id])
  tripId      Int?
  trip        Trip?       @relation(fields: [tripId], references: [id])
  createdAt   DateTime    @default(now())

  @@index([vehicleId])
  @@index([tripId])
  @@index([type])
  @@map("expenses")
}
