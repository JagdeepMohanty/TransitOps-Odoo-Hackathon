{
  "name": "transitops",
  "version": "1.0.0",
  "description": "TransitOps — Smart Transport Operations Platform",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm install --prefix client && npm install --prefix server",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "npm run dev --prefix client",
    "server": "npm run dev --prefix server",
    "build": "npm run build --prefix client",
    "prisma:generate": "npm run prisma:generate --prefix server",
    "prisma:migrate": "npm run prisma:migrate --prefix server",
    "prisma:seed": "npm run prisma:seed --prefix server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
